[Unit]
Description=LSMON privileged agent-provisioning worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lsmon-provisioner
Group=lsmon-provisioner
EnvironmentFile=/etc/lsmon/provisioner.env
WorkingDirectory=/opt/lsmon-portal
ExecStart=/opt/lsmon-portal/venv/bin/python /opt/lsmon-portal/manage.py provision_agent_jobs --execute --limit 10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lsmon-provisioner
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

